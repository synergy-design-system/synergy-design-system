{
  "name": "@synergy-design-system/root",
  "version": "0.1.0",
  "homepage": "https://synergy-design-system.github.io",
  "author": {
    "name": "SICK Global UX Foundation",
    "url": "https://www.sick.com"
  },
  "type": "module",
  "description": "SICK AG Synergy Design System for web based applications",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/synergy-design-system/synergy-design-system.git"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "build:size": "pnpm --filter @synergy-design-system/components... --if-present build",
    "build:sbom": "rm -f sboms/*.json && pnpm sbom --sbom-format spdx --prod --split --out 'sboms/%s.json' --filter './packages/*'",
    "clean": "rm -rf node_modules && find . -name dist -type d | xargs rm -rf && find . -name node_modules -type d | xargs rm -rf && pnpm install && pnpm build",
    "lint": "pnpm --recursive --if-present lint",
    "format": "pnpm run /^format..*/",
    "format.prettier": "pnpm exec prettier . -w",
    "format.eslint": "pnpm --recursive --if-present format.eslint",
    "release.validate": "node packages/_private/release-utils/src/lint.js",
    "release.create": "node packages/_private/release-utils/src/create.js",
    "release.status": "pnpm changeset status --since=main"
  },
  "private": true,
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.9.7",
    "update-browserslist-db": "^1.3.3"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
